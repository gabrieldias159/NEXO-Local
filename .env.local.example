# ── NEXO LOCAL — Firebase Emulator Suite ──────────────────────────────────────
# Copie este arquivo para `.env.local` (git-ignorado) na raiz do projeto.
# Liga o modo emulador para o `next dev` (cliente + rotas server-side do NEXO).
# Com estas flags, NENHUMA chamada vai para um Firebase de produção —
# Firestore, Auth e Storage são os emuladores locais (custo ZERO).
#
# Para apontar o dev local para um Firebase de PRODUÇÃO (não recomendado —
# este repo foi extraído do oficioexpress justamente para nunca precisar
# disso): apague ou renomeie este arquivo e reinicie o `next dev`.
NEXT_PUBLIC_USE_EMULATOR=1
NEXO_USE_EMULATOR=1

{
  "name": "functions",
  "description": "Cloud Functions do NEXO — crons de coleta, inteligência (linkage/perfil/score) e infra de jobs. Extraído do oficioexpress; roda contra o Firebase Emulator Suite.",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "true",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/storage": "^7.19.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.9.3"
  },
  "private": true
}
